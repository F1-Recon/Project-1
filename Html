<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Benteng Surosowan – Warisan Kejayaan Banten</title>
  <style>
    *, *::before, *::after {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    :root {
      --brown-dark:  #3b2a1a;
      --brown-mid:   #6b4226;
      --brown-light: #a0522d;
      --gold:        #c9a227;
      --gold-light:  #f0c040;
      --cream:       #fdf6e3;
      --text-dark:   #2c1a0e;
      --text-mid:    #5a3e28;
      --shadow:      0 4px 20px rgba(0,0,0,.25);
    }

    html { scroll-behavior: smooth; }

    body {
      font-family: 'Georgia', 'Times New Roman', serif;
      background: var(--cream);
      color: var(--text-dark);
      line-height: 1.8;
    }

    /* NAVIGATION */
    nav {
      position: fixed;
      top: 0; left: 0; right: 0;
      z-index: 100;
      background: rgba(59, 42, 26, .95);
      backdrop-filter: blur(6px);
      display: flex;
      justify-content: center;
      gap: 2rem;
      padding: .8rem 1.5rem;
      box-shadow: 0 2px 12px rgba(0,0,0,.4);
      flex-wrap: wrap;
    }

    nav a {
      color: var(--gold-light);
      text-decoration: none;
      font-size: .85rem;
      letter-spacing: .08em;
      text-transform: uppercase;
      transition: color .25s;
    }

    nav a:hover { color: #fff; }

    /* HERO */
    .hero {
      min-height: 100vh;
      background:
        linear-gradient(to bottom, rgba(0,0,0,.55) 0%, rgba(59,42,26,.85) 100%),
        url('https://upload.wikimedia.org/wikipedia/commons/thumb/8/8f/Keraton_Surosowan.jpg/1280px-Keraton_Surosowan.jpg')
        center/cover no-repeat;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      text-align: center;
      padding: 6rem 1.5rem 3rem;
    }

    .hero-badge {
      font-size: .78rem;
      letter-spacing: .22em;
      text-transform: uppercase;
      color: var(--gold-light);
      margin-bottom: 1rem;
    }

    .hero h1 {
      font-size: clamp(2.2rem, 6vw, 4.5rem);
      color: #fff;
      text-shadow: 0 2px 14px rgba(0,0,0,.6);
      line-height: 1.15;
    }

    .hero h1 span { color: var(--gold-light); }

    .hero p {
      margin-top: 1.2rem;
      max-width: 580px;
      color: #e8d9c0;
      font-size: 1.05rem;
    }

    .hero-divider {
      width: 80px;
      height: 3px;
      background: var(--gold);
      margin: 1.8rem auto 0;
      border-radius: 2px;
    }

    /* SECTION COMMON */
    section { padding: 80px 1.5rem; }

    .container {
      max-width: 920px;
      margin: 0 auto;
    }

    .section-title {
      text-align: center;
      margin-bottom: 2.8rem;
    }

    .section-title h2 {
      font-size: clamp(1.6rem, 4vw, 2.3rem);
      color: var(--brown-dark);
      display: inline-block;
    }

    .section-title h2::after {
      content: '';
      display: block;
      width: 60px;
      height: 3px;
      background: var(--gold);
      margin: .5rem auto 0;
      border-radius: 2px;
    }

    .section-title p {
      color: var(--text-mid);
      margin-top: .7rem;
      font-size: .95rem;
    }

    /* GALERI */
    #galeri { background: #f5ead4; }

    .gallery-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
      gap: 1.2rem;
    }

    .gallery-item {
      border-radius: 10px;
      overflow: hidden;
      box-shadow: var(--shadow);
    }

    .gallery-item img {
      width: 100%;
      height: 220px;
      object-fit: cover;
      display: block;
      transition: transform .4s ease;
    }

    .gallery-item:hover img { transform: scale(1.05); }

    .gallery-caption {
      background: var(--brown-dark);
      color: #f0d9b5;
      font-size: .82rem;
      padding: .5rem .9rem;
      text-align: center;
    }

    /* INFORMASI */
    #informasi { background: var(--cream); }

    .info-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(165px, 1fr));
      gap: 1.1rem;
      margin-bottom: 2.5rem;
    }

    .info-card {
      background: #fff;
      border-left: 4px solid var(--gold);
      border-radius: 8px;
      padding: 1.2rem 1rem;
      box-shadow: var(--shadow);
      text-align: center;
    }

    .info-card .icon { font-size: 1.9rem; margin-bottom: .4rem; }

    .info-card .label {
      font-size: .72rem;
      text-transform: uppercase;
      letter-spacing: .1em;
      color: var(--brown-light);
      margin-bottom: .25rem;
    }

    .info-card .value {
      font-size: .95rem;
      font-weight: bold;
      color: var(--brown-dark);
    }

    .desc-box {
      background: #fff;
      border-radius: 10px;
      padding: 2rem;
      box-shadow: var(--shadow);
    }

    .desc-box p + p { margin-top: 1rem; }

    /* SEJARAH */
    #sejarah { background: #f0e6d0; }

    .timeline {
      position: relative;
      padding-left: 2.5rem;
    }

    .timeline::before {
      content: '';
      position: absolute;
      left: .75rem;
      top: 0; bottom: 0;
      width: 2px;
      background: var(--gold);
    }

    .timeline-item {
      position: relative;
      margin-bottom: 2.2rem;
    }

    .timeline-item::before {
      content: '';
      position: absolute;
      left: -1.9rem;
      top: .38rem;
      width: 14px;
      height: 14px;
      background: var(--gold);
      border-radius: 50%;
      border: 3px solid #f0e6d0;
      box-shadow: 0 0 0 2px var(--gold);
    }

    .timeline-item .year {
      display: block;
      font-size: .78rem;
      font-weight: bold;
      letter-spacing: .12em;
      color: var(--brown-light);
      text-transform: uppercase;
      margin-bottom: .2rem;
    }

    .timeline-item h3 {
      font-size: 1.05rem;
      color: var(--brown-dark);
      margin-bottom: .4rem;
    }

    .timeline-item p {
      font-size: .93rem;
      color: var(--text-mid);
    }

    /* FUN FACTS */
    #funfact { background: var(--cream); }

    .fact-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(265px, 1fr));
      gap: 1.4rem;
    }

    .fact-card {
      background: linear-gradient(135deg, var(--brown-dark), var(--brown-mid));
      color: #fdf6e3;
      border-radius: 12px;
      padding: 1.6rem 1.4rem;
      box-shadow: var(--shadow);
      position: relative;
      overflow: hidden;
    }

    .fact-card::before {
      content: attr(data-num);
      position: absolute;
      top: -10px; right: 12px;
      font-size: 5rem;
      font-weight: 900;
      color: rgba(255,255,255,.06);
      line-height: 1;
      pointer-events: none;
    }

    .fact-card .fact-icon { font-size: 1.8rem; margin-bottom: .6rem; }

    .fact-card h3 {
      font-size: 1rem;
      color: var(--gold-light);
      margin-bottom: .45rem;
    }

    .fact-card p {
      font-size: .88rem;
      line-height: 1.7;
      color: #e8d9c0;
    }

    /* KUNJUNGI */
    #kunjungi { background: #f0e6d0; }

    .visit-box {
      background: #fff;
      border-radius: 12px;
      padding: 2rem;
      box-shadow: var(--shadow);
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(210px, 1fr));
      gap: 1.6rem;
    }

    .visit-item h3 {
      font-size: .82rem;
      text-transform: uppercase;
      letter-spacing: .1em;
      color: var(--brown-light);
      margin-bottom: .5rem;
    }

    .visit-item p,
    .visit-item li {
      font-size: .92rem;
      color: var(--text-mid);
      line-height: 1.75;
    }

    .visit-item ul { padding-left: 1.2rem; }

    /* FOOTER */
    footer {
      background: var(--brown-dark);
      color: #c9b49a;
      text-align: center;
      padding: 2rem 1.5rem;
      font-size: .82rem;
      line-height: 1.75;
    }

    footer a {
      color: var(--gold-light);
      text-decoration: none;
    }
  </style>
</head>
